# ─────────────────────────────────────────────────────────────
# Bedar — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Only VITE_* variables are exposed to the browser bundle, and Vite
# INLINES them at build time — a change here needs a rebuild, not a
# restart. On Vercel, set every VITE_* var below in
# Project → Settings → Environment Variables for Production, Preview
# AND Development, then redeploy; a missing one silently ships an
# empty string.
# ─────────────────────────────────────────────────────────────

# Supabase. The anon key is public by design — it is protected by RLS,
# and the public site reads published rows with it over PostgREST.
# Without these two the site still builds and runs entirely off the
# local seed in `src/content/` (`hasSupabase` is false).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site
VITE_SITE_URL=https://bedar.org
VITE_SITE_NAME=بدار

# Analytics. Falls back to the dashboard's `integrations` setting.
VITE_GTM_CONTAINER_ID=

# ─────────────────────────────────────────────────────────────
# FORM EMAIL DELIVERY — read by the Vercel serverless functions in
# `api/` (contact + newsletter), which email submissions to the site
# inbox via Resend. Set these in Vercel → Settings → Environment
# Variables for Production AND Preview. Must NOT be prefixed with
# VITE_ — a VITE_ copy would ship the API key to every visitor.
#
# Before bedar.org is verified in Resend: leave FROM as the default
# and set TO to the address you registered with Resend (Resend only
# delivers to the account owner until a domain is verified). After
# verifying bedar.org: set FROM to an address on it and TO to
# info@bedar.org.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
CONTACT_TO_EMAIL=info@bedar.org
CONTACT_FROM_EMAIL=Bedar <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# CAPTCHA — the SECRET key, read by the /api form endpoints when
# they verify a submission's token (client note ٤). Required as soon
# as a captcha provider is selected in the dashboard: with a provider
# configured and this missing, the endpoints refuse every submission
# rather than quietly accepting unverified ones.
#
# The SITE key is NOT here — it is public by definition and lives in
# the dashboard (التكاملات → الحماية من السبام), so it can be changed
# without a deploy. Only the secret is an environment variable, and
# it must NEVER be prefixed VITE_ or it ships to every visitor.
# ─────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# HCAPTCHA_SECRET_KEY=
# TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# SUPABASE, FOR THE SERVERLESS FUNCTIONS.
#
# The endpoints in `api/` read `site_settings` (captcha config,
# robots.txt body, sitemap options) and INSERT into
# `form_submissions`. Both are anon-key operations under RLS — see
# lib/settings.js — so these are the same two public values as the
# VITE_ pair above, without the prefix.
#
# Optional: if unset, the functions fall back to the VITE_ copies,
# which Vercel already has for the browser build. Set them explicitly
# only if you want the functions pointed at a different project.
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# The canonical origin used in /robots.txt and /sitemap.xml. Falls
# back to VITE_SITE_URL, then to https://bedar.org.
# SITE_URL=https://bedar.org

# ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — used by the seed script and by Supabase Edge
# Functions. Must NOT be prefixed with VITE_ and must NOT reach the
# browser. Do not add these to Vercel: nothing in the deployed app
# reads them, and a VITE_-prefixed copy would be published to every
# visitor.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_TARGET_BRANCH=
