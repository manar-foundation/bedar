# ─────────────────────────────────────────────────────────────
# Bedar — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Only VITE_* variables are exposed to the browser bundle, and Vite
# INLINES them at build time — a change here needs a rebuild, not a
# restart. On Vercel, set every VITE_* var below in
# Project → Settings → Environment Variables for Production, Preview
# AND Development, then redeploy; a missing one silently ships an
# empty string.
# ─────────────────────────────────────────────────────────────

# Supabase. The anon key is public by design — it is protected by RLS,
# and the public site reads published rows with it over PostgREST.
# Without these two the site still builds and runs entirely off the
# local seed in `src/content/` (`hasSupabase` is false).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site
VITE_SITE_URL=https://bedar.org
VITE_SITE_NAME=بدار

# Analytics. The dashboard's `integrations.gtmContainerId` wins; this
# is only the fallback for a deploy that wants the container fixed
# before anyone signs in to /admin.
VITE_GTM_CONTAINER_ID=

# ─────────────────────────────────────────────────────────────
# FORM EMAIL DELIVERY — read by the Vercel serverless functions in
# `api/` (contact + newsletter), which email submissions to the site
# inbox via Resend. Set these in Vercel → Settings → Environment
# Variables for Production AND Preview. Must NOT be prefixed with
# VITE_ — a VITE_ copy would ship the API key to every visitor.
#
# Before bedar.org is verified in Resend: leave FROM as the default
# and set TO to the address you registered with Resend (Resend only
# delivers to the account owner until a domain is verified). After
# verifying bedar.org: set FROM to an address on it and TO to
# info@bedar.org.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
CONTACT_TO_EMAIL=info@bedar.org
CONTACT_FROM_EMAIL=Bedar <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# reCAPTCHA — client notes §4.
#
# The SITE key is NOT here: it is public by definition (it is
# transmitted to every visitor in the page) and it is a dashboard
# setting, at /admin/integrations.
#
# The SECRET key is server-side only and must NEVER be prefixed
# VITE_ — that prefix inlines a value into the JavaScript every
# visitor downloads. `lib/recaptcha.js` is the only code that reads
# it, and it runs in the Vercel serverless runtime.
#
# BEHAVIOUR: with this set, /api/contact and /api/newsletter REQUIRE
# a valid token and refuse the submission without one. With it unset,
# verification is skipped and the submission proceeds — so a preview
# deploy that has not had the secret copied in still works, and the
# skip is recorded on the stored row rather than looking like a pass.
# Set it in Vercel → Settings → Environment Variables for Production
# AND Preview.
# ─────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
# v3 only — the score below which a submission is treated as a bot.
# Ignored by the v2 keys currently in use. Default 0.5.
# RECAPTCHA_SCORE_THRESHOLD=0.5

# ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — the seed script, Supabase Edge Functions, and
# the `api/` serverless functions. Must NOT be prefixed with VITE_
# and must NOT reach the browser.
#
# SUPABASE_SERVICE_ROLE_KEY *does* now have to be set in Vercel:
# `api/contact.js` and `api/newsletter.js` use it to write
# `form_submissions` (client notes §2). That table has no anon write
# policy on purpose — an anon INSERT policy would be an open,
# unauthenticated write endpoint into the database. The key bypasses
# every RLS policy in the project, so it belongs in the serverless
# environment and nowhere else.
#
# SUPABASE_URL / SUPABASE_ANON_KEY are optional: the functions fall
# back to the VITE_ copies above, which a Vercel project already has.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Absolute origin for the /robots.txt and /sitemap.xml links. Falls
# back to VITE_SITE_URL, then to the request's own host.
# SITE_URL=https://bedar.org
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_TARGET_BRANCH=
